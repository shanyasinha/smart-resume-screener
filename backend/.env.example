# Choose which LLM provider to use for match scoring: "anthropic", "openai", or "none"
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage
DATABASE_URL=sqlite:///./resume_screener.db

# How much the final score weighs the LLM's semantic judgement vs.
# transparent keyword overlap (must sum to 1 internally; only this one is set)
LLM_SCORE_WEIGHT=0.7

# Frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
